---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

// Featured first, then the rest, both keep their declared order.
const sorted = [...projects].sort(
  (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false)
);
---

<Layout title="Projects | Darren Haryanto">
  <section class="mb-16">
    <a
      href="/#content"
      class="inline-flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors mb-10"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to portfolio
    </a>

    <h1 class="text-primary font-display font-medium text-5xl md:text-6xl tracking-tight mb-4">Projects<span class="text-accent">.</span></h1>
    <p class="text-muted leading-relaxed text-lg max-w-2xl">
      A selection of things I've built: mobile apps, tooling, and the web. Click any project for
      its full write-up.
    </p>
  </section>

  <section class="grid gap-6 sm:grid-cols-2">
    {sorted.map((project) => (
      <a
        href={`/projects/${project.slug}`}
        data-tilt
        data-reveal
        class="group flex flex-col bg-surface border border-border hover:border-accent rounded-lg p-6 hover:shadow-xl"
      >
        <div class="flex items-start justify-between gap-3 mb-3">
          <h2 class="text-primary font-display font-medium text-2xl group-hover:text-accent transition-colors">
            {project.name}
          </h2>
          <span class="shrink-0 text-[10px] uppercase tracking-wider text-accent bg-accent/10 px-2.5 py-1 rounded-full font-semibold">
            {project.status}
          </span>
        </div>

        <p class="text-muted text-sm leading-relaxed mb-5 flex-1">{project.tagline}</p>

        <div class="flex flex-wrap gap-2 mb-5">
          {project.tech.slice(0, 4).map((tag) => (
            <span class="text-xs text-muted font-mono border border-border rounded-full px-2.5 py-0.5">
              {tag}
            </span>
          ))}
        </div>

        <div class="flex items-center justify-between text-xs text-muted mt-auto">
          <span class="font-mono">{project.year}</span>
          <span class="inline-flex items-center gap-1 text-accent font-medium">
            Read the docs
            <svg
              class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </span>
        </div>
      </a>
    ))}
  </section>

  <footer class="text-center text-sm text-muted pt-16 mt-16 border-t border-border">
    <p>&copy; {new Date().getFullYear()} Darren Haryanto. Built with Astro.</p>
  </footer>
</Layout>
