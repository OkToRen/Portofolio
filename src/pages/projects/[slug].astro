---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.name} | Darren Haryanto`}>
  <article>
    <a
      href="/projects"
      class="inline-flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors mb-10"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      All projects
    </a>

    <!-- Header -->
    <header class="mb-12 pb-10 border-b border-border">
      <h1 class="text-primary font-display font-medium text-5xl md:text-6xl tracking-tight mb-4">{project.name}</h1>
      <p class="text-muted text-lg leading-relaxed max-w-2xl">{project.tagline}</p>
      <p class="flex items-center gap-3 mt-4 text-sm">
        <span class="text-accent font-semibold">{project.status}</span>
        <span class="text-muted font-mono">{project.year}</span>
      </p>

      {project.links.length > 0 && (
        <div class="flex flex-wrap gap-3 mt-8">
          {project.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-surface border border-border hover:border-accent text-primary hover:text-accent text-sm font-medium px-4 py-2 rounded-lg transition-[scale,border-color,color] duration-200 ease-out active:scale-[0.97]"
            >
              {link.label}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10v10"></path>
              </svg>
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Meta sidebar + summary -->
    <div class="grid md:grid-cols-3 gap-10 mb-14">
      <aside class="md:col-span-1 space-y-6">
        <div>
          <h2 class="text-muted font-bold uppercase tracking-wider text-sm mb-2">Role</h2>
          <p class="text-primary text-sm">{project.role}</p>
        </div>

        {project.tech.length > 0 && (
          <div>
            <h2 class="text-muted font-bold uppercase tracking-wider text-sm mb-3">Tech Stack</h2>
            <div class="flex flex-wrap gap-2">
              {project.tech.map((tag) => (
                <span class="text-xs text-primary font-mono bg-surface border border-border rounded-full px-2.5 py-1">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        {project.highlights.length > 0 && (
          <div>
            <h2 class="text-muted font-bold uppercase tracking-wider text-sm mb-3">Highlights</h2>
            <ul class="list-disc pl-4 space-y-2 marker:text-accent">
              {project.highlights.map((item) => (
                <li class="text-sm text-muted leading-relaxed">{item}</li>
              ))}
            </ul>
          </div>
        )}
      </aside>

      <div class="md:col-span-2">
        <p class="text-primary text-lg leading-relaxed">{project.summary}</p>
      </div>
    </div>

    <!-- Hallmark · component: gallery (filmstrip) · genre: editorial · compact horizontal scroll -->
    {project.images && project.images.length > 0 && (
      <section class="mb-14">
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="text-muted font-bold uppercase tracking-wider text-sm">Gallery</h2>
          <span class="text-xs text-muted font-mono">{project.images.length} screenshots</span>
        </div>
        <div class="relative group/gallery">
          <div
            id="gallery-strip"
            data-lenis-prevent-wheel
            class="flex gap-3 overflow-x-auto scroll-smooth pb-3 snap-x [scrollbar-width:thin] [scrollbar-color:var(--color-border)_transparent]"
          >
            {project.images.map((img) => (
              <figure class="shrink-0 snap-start">
                <button type="button" aria-haspopup="dialog" class="block rounded-lg cursor-zoom-in">
                  <img
                    src={img.src}
                    alt={img.alt}
                    loading="lazy"
                    data-lightbox
                    class="h-32 sm:h-40 w-auto rounded-lg border border-border transition duration-300 hover:-translate-y-0.5 hover:border-accent"
                  />
                </button>
              </figure>
            ))}
          </div>

          <button
            type="button"
            id="gallery-prev"
            aria-label="Scroll to previous screenshots"
            class="hidden sm:flex absolute left-1 top-1/2 -mt-1.5 -translate-y-1/2 z-10 h-9 w-9 items-center justify-center rounded-full bg-surface border border-border text-primary opacity-0 group-hover/gallery:opacity-100 group-focus-within/gallery:opacity-100 hover:border-accent hover:text-accent transition active:scale-[0.97] cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
          </button>
          <button
            type="button"
            id="gallery-next"
            aria-label="Scroll to next screenshots"
            class="hidden sm:flex absolute right-1 top-1/2 -mt-1.5 -translate-y-1/2 z-10 h-9 w-9 items-center justify-center rounded-full bg-surface border border-border text-primary opacity-0 group-hover/gallery:opacity-100 group-focus-within/gallery:opacity-100 hover:border-accent hover:text-accent transition active:scale-[0.97] cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </section>
    )}

    <!-- Documentation -->
    <div class="space-y-12">
      {project.documentation.map((section) => (
        <section data-reveal>
          <h2 class="text-primary font-display font-medium text-3xl tracking-tight mb-5">{section.heading}</h2>
          {section.paragraphs?.map((para) => (
            <p class="text-muted leading-relaxed text-base mb-4 max-w-[70ch]">{para}</p>
          ))}
          {section.bullets && (
            <ul class="list-disc list-outside pl-5 space-y-2 text-muted leading-relaxed max-w-[70ch]">
              {section.bullets.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>

    <div class="text-center text-sm pt-16 mt-16">
      <a href="/projects" class="text-accent hover:underline">← Back to all projects</a>
    </div>
    <Footer class="mt-12 pt-10" />
  </article>
</Layout>
