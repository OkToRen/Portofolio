					</nav>
				</div>
			</div>
			
			<a href="/cv.pdf" download="Darren_Haryanto_CV.pdf"
			   id="cv-download"
			   data-magnetic
			   class="p-3 rounded-lg bg-surface border border-border hover:border-accent transition-[transform,scale,border-color,color] duration-200 ease-out active:scale-[0.97] flex items-center gap-2 text-sm font-medium text-primary hover:text-accent"
			   aria-label="Download CV">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
				</svg>
				<span class="hidden sm:inline">CV</span>
			</a>
			
			<button id="theme-toggle" data-magnetic class="p-3 rounded-lg bg-surface border border-border hover:border-accent transition-[transform,scale,border-color] duration-200 ease-out active:scale-[0.97]" aria-label="Toggle theme">
				<svg id="theme-icon-dark" class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
