		<main id="main" tabindex="-1" class="max-w-4xl mx-auto px-6 py-20 focus:outline-none">
			<slot />
		</main>

		<!-- Pointer-effect layers (fine pointer only; styled in global.css) -->
		<div class="cursor-spotlight" aria-hidden="true"></div>
		<div class="cursor-ring" aria-hidden="true"><span class="cursor-ring__inner"></span></div>

		<!-- Lightbox overlay for screenshot galleries -->
		<div
			id="lightbox"
			class="fixed inset-0 z-[9998] hidden items-center justify-center bg-background/95 backdrop-blur-sm p-6 cursor-zoom-out"
			role="dialog"
			aria-modal="true"
			aria-label="Screenshot viewer. Arrow keys browse, Escape closes."
			aria-hidden="true"
			tabindex="-1"
		>
			<button id="lightbox-prev" type="button" aria-label="Previous screenshot" class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 h-11 w-11 flex items-center justify-center rounded-full bg-surface/80 border border-border text-primary hover:border-accent hover:text-accent transition cursor-pointer">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
			</button>
			<img id="lightbox-img" alt="" class="max-h-[90vh] max-w-[80vw] rounded-lg border border-border object-contain" />
			<button id="lightbox-next" type="button" aria-label="Next screenshot" class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 h-11 w-11 flex items-center justify-center rounded-full bg-surface/80 border border-border text-primary hover:border-accent hover:text-accent transition cursor-pointer">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
			</button>
		</div>
	</body>
</html>

<script>
	import Lenis from 'lenis';

	// Smooth wheel scrolling. Touch stays native, and Lenis turns itself off
	// under prefers-reduced-motion.
	const lenis = new Lenis({ autoRaf: true });

	// The theme class is set by the inline script in <head>, before first paint.

	const handleToggleClick = (event: MouseEvent) => {
		const element = document.documentElement;
		const button = event.currentTarget as HTMLElement;

		// Get the position of the button for the circular reveal animation
		const rect = button.getBoundingClientRect();
		const x = rect.left + rect.width / 2;
		const y = rect.top + rect.height / 2;

		// Calculate the maximum radius needed to cover the entire screen
		const endRadius = Math.hypot(
			Math.max(x, window.innerWidth - x),
			Math.max(y, window.innerHeight - y)
		);

		// Toggle the theme with a circular reveal animation
		const isDarkNow = !element.classList.contains('light');
		const newTheme = isDarkNow ? 'light' : 'dark';

		// Check if the browser supports View Transitions API
		if (!document.startViewTransition) {
			// Fallback for browsers that don't support View Transitions
			element.classList.toggle('light');
			localStorage.setItem('theme', newTheme);
			updateThemeIcon(!isDarkNow);
			return;
		}

		// Use View Transitions API for smooth circular reveal
		const transition = document.startViewTransition(() => {
			element.classList.toggle('light');
			localStorage.setItem('theme', newTheme);
			updateThemeIcon(!isDarkNow);
		});

		// Animate the transition with a circular clip-path
		transition.ready.then(() => {
			const clipPath = [
				`circle(0px at ${x}px ${y}px)`,
				`circle(${endRadius}px at ${x}px ${y}px)`
			];

			document.documentElement.animate(
				{ clipPath: clipPath },
				{
					duration: 700,
					easing: 'ease-in-out',
					pseudoElement: '::view-transition-new(root)'
				}
			);
		});
	};

	const updateThemeIcon = (isDark: boolean) => {
		const darkIcon = document.getElementById('theme-icon-dark');
		const lightIcon = document.getElementById('theme-icon-light');
		if (isDark) {
			darkIcon?.classList.remove('hidden');
			lightIcon?.classList.add('hidden');
		} else {
			darkIcon?.classList.add('hidden');
			lightIcon?.classList.remove('hidden');
		}
	};

	document.getElementById('theme-toggle')?.addEventListener('click', handleToggleClick);

	// Set initial icon state
	const isDark = !document.documentElement.classList.contains('light');
	updateThemeIcon(isDark);

	// Menu toggle functionality
	const menuToggle = document.getElementById('menu-toggle');
	const menuIconOpen = document.getElementById('menu-icon-open');
	const menuIconClose = document.getElementById('menu-icon-close');
	const dropdownMenu = document.getElementById('dropdown-menu');
	let isMenuOpen = false;

	const toggleMenu = () => {
		isMenuOpen = !isMenuOpen;
		menuToggle?.setAttribute('aria-expanded', String(isMenuOpen));

		if (isMenuOpen) {
			// Open menu
			dropdownMenu?.classList.remove('opacity-0', 'invisible', 'scale-95');
			dropdownMenu?.classList.add('opacity-100', 'visible', 'scale-100');
			menuIconOpen?.classList.add('hidden');
			menuIconClose?.classList.remove('hidden');
		} else {
			// Close menu
			dropdownMenu?.classList.add('opacity-0', 'invisible', 'scale-95');
			dropdownMenu?.classList.remove('opacity-100', 'visible', 'scale-100');
			menuIconOpen?.classList.remove('hidden');
			menuIconClose?.classList.add('hidden');
		}
	};

	menuToggle?.addEventListener('click', toggleMenu);

	// Close menu when clicking outside
	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		if (isMenuOpen && !menuToggle?.contains(target) && !dropdownMenu?.contains(target)) {
			toggleMenu();
		}
	});

	// Close menu when clicking a menu item
	dropdownMenu?.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', (e) => {
			const href = link.getAttribute('href');

			// Same-page anchors scroll; on other pages the link navigates normally
			const targetElement = href?.startsWith('/#') ? document.getElementById(href.substring(2)) : null;
			if (targetElement) {
				e.preventDefault();
				lenis.scrollTo(targetElement);
			}

			if (isMenuOpen) {
				toggleMenu();
			}
		});
	});

	// Control cluster: tuck it away while reading downwards (it would sit on
	// the text, especially on phones) and bring it back on any scroll up, when
	// the menu is open, or when it takes keyboard focus.
	const controls = document.getElementById('controls');
	if (controls) {
		let lastY = window.scrollY;
		lenis.on('scroll', () => {
			const y = window.scrollY;
			if (y < 120 || isMenuOpen || controls.contains(document.activeElement)) controls.classList.remove('is-tucked');
			else if (y > lastY + 4) controls.classList.add('is-tucked');
			else if (y < lastY - 4) controls.classList.remove('is-tucked');
			lastY = y;
		});
		controls.addEventListener('focusin', () => controls.classList.remove('is-tucked'));
	}

	// Respect the user's motion preference for all decorative interactions.
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Subtle pointer-driven tilt on cards marked [data-tilt].
	if (!prefersReducedMotion) {
		document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
			const MAX = 1.5; // degrees — kept minimal so cards barely drag with the pointer
			card.addEventListener('pointermove', (e) => {
				const r = card.getBoundingClientRect();
				const px = (e.clientX - r.left) / r.width - 0.5;
				const py = (e.clientY - r.top) / r.height - 0.5;
				card.style.transform = `perspective(900px) rotateX(${(-py * MAX).toFixed(2)}deg) rotateY(${(px * MAX).toFixed(2)}deg) translateY(-2px)`;
			});
			card.addEventListener('pointerleave', () => {
				card.style.transform = '';
			});
		});
	}

	// Pointer effects (fine pointer + motion-allowed only):
	//   4 · ring follows the cursor, reacts over interactive elements
	//   5 · faint glow pools under the pointer across #content only
	//   6 · control-cluster buttons lean toward the pointer
	const finePointer = window.matchMedia('(pointer: fine)').matches;

	if (finePointer && !prefersReducedMotion) {
		const ring = document.querySelector<HTMLElement>('.cursor-ring');
		const glow = document.querySelector<HTMLElement>('.cursor-spotlight');
		const magnets = Array.from(document.querySelectorAll<HTMLElement>('[data-magnetic]'));
		// The glow shows across the whole content field (margins included),
		// not just the centred text column — so gate on "past the hero"
		// rather than on the element under the pointer. Pages with no hero
		// (projects list/detail) are content top-to-bottom, so always on.
		const heroWrapper = document.querySelector('.hero-wrapper');

		let pointerX = window.innerWidth / 2;
		let pointerY = window.innerHeight / 2;
		let ringX = pointerX;
		let ringY = pointerY;
		let glowX = pointerX;
		let glowY = pointerY;

		const frame = () => {
			// Ring eases quickly; glow trails a touch slower for a liquid feel.
			ringX += (pointerX - ringX) * 0.2;
			ringY += (pointerY - ringY) * 0.2;
			glowX += (pointerX - glowX) * 0.12;
			glowY += (pointerY - glowY) * 0.12;
			if (ring) ring.style.transform = `translate(${ringX}px, ${ringY}px)`;
			if (glow) glow.style.transform = `translate(${glowX}px, ${glowY}px)`;
			requestAnimationFrame(frame);
		};

		window.addEventListener(
			'pointermove',
			(e) => {
				if (e.pointerType !== 'mouse') return;
				pointerX = e.clientX;
				pointerY = e.clientY;
				const el = e.target as HTMLElement;

				// 4 · ring — visible on move, accent + grown over interactive els
				if (ring) {
					ring.classList.add('is-visible');
					const interactive = el.closest('a, button, [data-tilt], input, label, [role="button"]');
					ring.classList.toggle('is-interactive', !!interactive);
				}

				// 5 · glow — across the content field, hidden while over the hero
				if (glow) {
					const pastHero = !heroWrapper || window.scrollY > window.innerHeight * 0.6;
					glow.classList.toggle('is-visible', pastHero);
				}

				// 6 · magnetic pull within proximity
				for (const magnet of magnets) {
					const r = magnet.getBoundingClientRect();
					const dx = e.clientX - (r.left + r.width / 2);
					const dy = e.clientY - (r.top + r.height / 2);
					const radius = Math.max(r.width, r.height) / 2 + 36;
					if (Math.hypot(dx, dy) < radius) {
						magnet.style.transform = `translate(${(dx * 0.28).toFixed(2)}px, ${(dy * 0.28).toFixed(2)}px)`;
					} else if (magnet.style.transform) {
						magnet.style.transform = '';
					}
				}
			},
			{ passive: true }
		);

		document.addEventListener('pointerleave', () => {
			ring?.classList.remove('is-visible');
			glow?.classList.remove('is-visible');
			for (const magnet of magnets) magnet.style.transform = '';
		});

		requestAnimationFrame(frame);
	}

	// Staggered scroll reveal for elements marked [data-reveal].
	const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
	if (revealEls.length) {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry, i) => {
					if (entry.isIntersecting) {
						const el = entry.target as HTMLElement;
						el.style.setProperty('--reveal-delay', `${Math.min(i * 90, 360)}ms`);
						el.classList.add('is-visible');
						revealObserver.unobserve(el);
					}
				});
			},
			{ threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
		);
		revealEls.forEach((el) => revealObserver.observe(el));
	}

	// Screenshot gallery: lightbox with prev/next traversal.
	const lightbox = document.getElementById('lightbox');
	const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
	const galleryImgs = Array.from(document.querySelectorAll<HTMLImageElement>('img[data-lightbox]'));

	if (lightbox && lightboxImg && galleryImgs.length) {
		let index = -1;
		let returnFocus: HTMLElement | null = null;
		const render = (i: number) => {
			index = (i + galleryImgs.length) % galleryImgs.length;
			const img = galleryImgs[index];
			lightboxImg.src = img.currentSrc || img.src;
			lightboxImg.alt = img.alt;
		};
		const open = (i: number) => {
			returnFocus = document.activeElement as HTMLElement | null;
			render(i);
			lightbox.classList.remove('hidden');
			lightbox.classList.add('flex');
			lightbox.setAttribute('aria-hidden', 'false');
			lenis.stop();
			lightbox.focus();
			// Enter softly; closing stays instant (exits should be faster than entries).
			const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
			lightbox.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 180, easing: ease });
			if (!prefersReducedMotion) {
				lightboxImg.animate([{ transform: 'scale(0.96)' }, { transform: 'none' }], { duration: 220, easing: ease });
			}
		};
		const closeLightbox = () => {
			lightbox.classList.add('hidden');
			lightbox.classList.remove('flex');
			lightbox.setAttribute('aria-hidden', 'true');
			lightboxImg.removeAttribute('src');
			index = -1;
			lenis.start();
			returnFocus?.focus();
		};
		// Each screenshot sits in a button, so Enter/Space open it too.
		galleryImgs.forEach((img, i) => (img.closest('button') ?? img).addEventListener('click', () => open(i)));
		lightboxImg.addEventListener('click', (e) => e.stopPropagation());
		lightbox.addEventListener('click', closeLightbox);
		document.getElementById('lightbox-prev')?.addEventListener('click', (e) => {
			e.stopPropagation();
			render(index - 1);
		});
		document.getElementById('lightbox-next')?.addEventListener('click', (e) => {
			e.stopPropagation();
			render(index + 1);
		});
		document.addEventListener('keydown', (e) => {
			if (lightbox.classList.contains('hidden')) return;
			if (e.key === 'Tab') {
				// Keep focus inside the dialog: cycle between its two buttons.
				const stops = [document.getElementById('lightbox-prev'), document.getElementById('lightbox-next')];
				const at = stops.indexOf(document.activeElement as HTMLElement);
				e.preventDefault();
				stops[(at + (e.shiftKey ? -1 : 1) + stops.length) % stops.length]?.focus();
			} else if (e.key === 'Escape') closeLightbox();
			else if (e.key === 'ArrowLeft') render(index - 1);
			else if (e.key === 'ArrowRight') render(index + 1);
		});
	}

	// Filmstrip: arrow buttons scroll it; vertical wheel scrolls horizontally.
	const strip = document.getElementById('gallery-strip');
	if (strip) {
		const step = () => Math.max(strip.clientWidth * 0.8, 220);
		document.getElementById('gallery-prev')?.addEventListener('click', () =>
			strip.scrollBy({ left: -step(), behavior: 'smooth' })
		);
		document.getElementById('gallery-next')?.addEventListener('click', () =>
			strip.scrollBy({ left: step(), behavior: 'smooth' })
		);
		strip.addEventListener(
			'wheel',
			(e) => {
				if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
					strip.scrollLeft += e.deltaY;
					e.preventDefault();
				}
			},
			{ passive: false }
		);
	}
</script>

<style is:global>
	/* View Transitions API styling for smooth theme changes */
	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}

	::view-transition-old(root) {
		z-index: 1;
	}

	::view-transition-new(root) {
		z-index: 999;
	}

	/* Fallback for browsers that don't support View Transitions */
	@supports not selector(::view-transition-group(*)) {
		html {
			transition: background-color 0.5s ease-in-out, color 0.5s ease-in-out;
		}
		
		* {
			transition: background-color 0.3s ease-in-out, 
						color 0.3s ease-in-out, 
						border-color 0.3s ease-in-out,
						box-shadow 0.3s ease-in-out;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		::view-transition-old(root),
		::view-transition-new(root) {
			animation: none !important;
		}
		
		* {
			transition: none !important;
		}
	}

	/* Custom scrollbar for that raw engineering feel, themed from the tokens
	   so it follows light and dark */
	html {
		scrollbar-color: var(--color-border) var(--color-background);
	}
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: var(--color-background);
	}
	::-webkit-scrollbar-thumb {
		background: var(--color-border);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--color-muted);
	}

	#controls.is-tucked {
		transform: translateY(calc(-100% - 2rem));
	}
</style>