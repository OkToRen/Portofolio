---
import { createHash } from 'node:crypto';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Font } from 'astro:assets';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

import { identity, personSchema } from '../data/identity';

interface Props {
	title: string;
	/** One or two sentences for search results and link previews. */
	description?: string;
	/** Link-preview screenshot in public/og/ (made by npm run brand), without the extension. */
	og?: string;
	type?: 'website' | 'profile' | 'article';
	/** Extra schema.org nodes for this page, added to the site-wide graph. */
	schema?: Record<string, unknown>[];
}

const { title, description = identity.summary, og = 'home', type = 'website', schema = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
// Version the preview URL by the image's contents. Cloudflare and the chat
// apps cache whatever they first got for a URL (a 404 included), so a new
// screenshot needs a new URL to be seen.
// A page added since the last `npm run brand` has no screenshot yet, so it
// borrows the home one until the next run.
const ogPath = (name: string) => join(process.cwd(), 'public', 'og', `${name}.jpg`);
const ogName = existsSync(ogPath(og)) ? og : 'home';
const ogVersion = createHash('sha1').update(readFileSync(ogPath(ogName))).digest('hex').slice(0, 8);
const image = new URL(`/og/${ogName}.jpg?v=${ogVersion}`, Astro.site).href;
const imageAlt = `Screenshot of ${title} on darrenharyanto.com`;

const graph = {
	'@context': 'https://schema.org',
	'@graph': [
		personSchema(),
		{
			'@type': 'WebSite',
			'@id': `${identity.url}/#website`,
			url: identity.url,
			name: identity.name,
			description: identity.summary,
			inLanguage: 'en',
			publisher: { '@id': `${identity.url}/#person` },
		},
		...schema,
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={identity.fullName} />
		<link rel="canonical" href={canonical} />

		<!-- The DO mark: tab, bookmarks, home screen -->
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#0d0d0f" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#fafafb" media="(prefers-color-scheme: light)" />

		<!-- Link previews (WhatsApp, LinkedIn, X, Slack, iMessage, Discord) -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={identity.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:locale" content="en_US" />
		{type === 'profile' && <meta property="profile:first_name" content="Darren" />}
		{type === 'profile' && <meta property="profile:last_name" content="Haryanto" />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<!-- Who this is, for search engines and AI agents -->
		<script type="application/ld+json" set:html={JSON.stringify(graph)} />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="About Darren Haryanto, for AI agents" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		<link rel="me" href={identity.profiles.github} />
		<link rel="me" href={identity.profiles.linkedin} />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-fraunces" preload />
		<Font cssVariable="--font-inter-tight" preload />
		<Font cssVariable="--font-jetbrains-mono" preload />
		<!-- Runs before first paint so a light-mode visitor never sees the dark default -->
		<script is:inline>
			(() => {
				let theme = null;
				try { theme = localStorage.getItem('theme'); } catch {}
				if (!theme) theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				document.documentElement.classList.toggle('light', theme === 'light');
				try { localStorage.setItem('theme', theme); } catch {}
			})();
		</script>
	</head>
	<body class="bg-background text-primary font-sans antialiased selection:bg-accent selection:text-white transition-colors duration-300">
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-6 focus:left-6 focus:z-[10000] focus:px-4 focus:py-3 focus:rounded-lg focus:bg-surface focus:text-primary focus:border focus:border-accent">Skip to content</a>
		<!-- Control cluster: slides away while scrolling down so it never sits on the text, returns on scroll up -->
		<div id="controls" class="fixed top-6 right-6 flex gap-3 z-50 transition-transform duration-200 ease-out">
			<!-- Collapsible Menu Button -->
			<div class="relative">
				<button id="menu-toggle" data-magnetic class="p-3 rounded-lg bg-surface border border-border hover:border-accent transition-[transform,scale,border-color] duration-200 ease-out active:scale-[0.97]" aria-label="Toggle menu" aria-expanded="false" aria-controls="dropdown-menu">
					<svg id="menu-icon-open" class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
					<svg id="menu-icon-close" class="w-5 h-5 text-accent hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
				
				<!-- Dropdown Menu -->
				<div id="dropdown-menu" class="absolute top-full right-0 mt-2 w-48 rounded-lg bg-surface border border-border shadow-lg opacity-0 invisible transition-[opacity,scale,visibility] duration-150 ease-out scale-95 origin-top-right">
					<nav class="py-2">
						<a href="/#content" class="block px-4 py-2.5 text-sm text-primary hover:text-accent hover:bg-background transition-colors">
							<div class="flex items-center gap-2">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
								</svg>
								<span>Content</span>
							</div>
						</a>
						<a href="/projects" class="block px-4 py-2.5 text-sm text-primary hover:text-accent hover:bg-background transition-colors">
							<div class="flex items-center gap-2">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
								</svg>
